# URL canonique de l'application (confirmation e-mail et callbacks)
NEXT_PUBLIC_APP_URL=https://mia-assistant-phi.vercel.app

# Supabase — valeurs publiques uniquement côté navigateur
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Moteurs MIA — secrets côté serveur uniquement
# Choix: openai ou anthropic
MIA_PROVIDER=openai
MIA_MODEL=gpt-6-astra
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Recherche web (à connecter séparément)
MIA_WEB_SEARCH_PROVIDER=
MIA_WEB_SEARCH_API_KEY=
