# URL canonique de l'application (confirmation e-mail et callbacks)
NEXT_PUBLIC_APP_URL=https://mia-assistant-phi.vercel.app

# Supabase — valeurs publiques uniquement côté navigateur
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Vercel AI Gateway (secret côté serveur; en production Vercel OIDC peut être utilisé)
AI_GATEWAY_API_KEY=

# Modèle configurable via AI Gateway
MIA_MODEL=google/gemini-3.1-flash
